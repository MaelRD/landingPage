---
/**
 * Muestra una imagen optimizada o, si aún no existe, un placeholder elegante
 * que comunica qué foto va en ese lugar.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import type { MediaTone } from '@/types';

interface Props {
  label: string;
  icon: IconName;
  tone?: MediaTone;
  image?: ImageMetadata;
  alt?: string;
  sizes?: string;
  class?: string;
}

const { label, icon, tone = 'brand', image, alt, sizes = '(min-width: 1024px) 50vw, 100vw', class: className } =
  Astro.props;

const tones: Record<MediaTone, string> = {
  brand: 'from-brand-100 via-brand-50 to-accent-50 text-brand-700',
  accent: 'from-accent-100 via-accent-50 to-white text-accent-700',
  sand: 'from-sand-200 via-sand-100 to-white text-brand-800',
};
---

{
  image ? (
    <Image
      src={image}
      alt={alt ?? label}
      sizes={sizes}
      widths={[480, 800, 1200, 1600]}
      class:list={['size-full object-cover', className]}
    />
  ) : (
    <div
      role="img"
      aria-label={`${label} (imagen de referencia)`}
      class:list={['relative grid size-full place-items-center overflow-hidden bg-linear-to-br', tones[tone], className]}
    >
      <span
        class="absolute inset-0 bg-[radial-gradient(currentColor_1px,transparent_1.5px)] bg-size-[18px_18px] opacity-[0.12]"
        aria-hidden="true"
      />
      <span class="relative grid size-16 place-items-center rounded-2xl bg-white/70 shadow-soft ring-1 ring-white backdrop-blur-sm">
        <Icon name={icon} size={28} />
      </span>
    </div>
  )
}
