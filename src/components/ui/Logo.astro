---
import { SITE } from '@/config/site';

interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}

const { tone = 'dark', class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <rect width="32" height="32" rx="10" class={tone === 'dark' ? 'fill-brand-900' : 'fill-white'}></rect>
    <path
      d="M11.2 8.5c-2 0-3.6 1.6-3.6 3.8 0 2 .8 3.2 1.4 4.8.6 1.6.8 3.6 1.2 5.5.3 1.1.7 1.9 1.6 1.9 1 0 1.2-1 1.5-2.4.3-1.3.5-2.9 2.3-2.9s2 1.6 2.3 2.9c.3 1.4.5 2.4 1.5 2.4.9 0 1.3-.8 1.6-1.9.4-1.9.6-3.9 1.2-5.5.6-1.6 1.4-2.8 1.4-4.8 0-2.2-1.6-3.8-3.6-3.8-1.7 0-2.6.9-4.4.9s-2.7-.9-4.4-.9Z"
      fill="none"
      stroke-width="1.8"
      stroke-linejoin="round"
      class={tone === 'dark' ? 'stroke-white' : 'stroke-brand-900'}></path>
    <circle cx="23.5" cy="8.5" r="2.2" class="fill-accent-400"></circle>
  </svg>
  <span
    class:list={[
      'font-display text-[1.2rem] leading-none font-bold whitespace-nowrap tracking-[-0.035em]',
      tone === 'dark' ? 'text-ink' : 'text-white',
    ]}
  >
    {SITE.name}
  </span>
</span>
