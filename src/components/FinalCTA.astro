---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';

interface Props {
  title: string;
  description: string;
  cta: { label: string; href: string };
  phone: { display: string; href: string };
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, cta, phone, image, imageAlt = '' } = Astro.props;
---

<section aria-labelledby="cta-final-title" class="pb-[clamp(4.5rem,10vw,8rem)]">
  <div class="container-page">
    <div
      data-animate="scale"
      class="grain relative grid overflow-clip rounded-4xl bg-brand-950 text-white lg:grid-cols-[1.15fr_1fr] lg:rounded-[2.75rem]"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute -top-32 -left-24 size-96 rounded-full bg-brand-500/35 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 size-96 rounded-full bg-accent-500/25 blur-3xl"></div>
      </div>

      <div class="px-6 py-14 sm:px-12 sm:py-20 lg:py-24 lg:pr-6 lg:pl-16">
        <h2
          id="cta-final-title"
          class="max-w-xl font-display text-[clamp(2.2rem,1.4rem+3.4vw,4.25rem)] leading-[1.05] font-bold tracking-[-0.04em]"
        >
          {title}
        </h2>
        <p class="mt-6 max-w-lg text-base leading-relaxed text-brand-100/80 sm:text-lg">{description}</p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
          <Button href={cta.href} external variant="inverse" size="lg" icon="whatsapp" class="w-full sm:w-auto">
            {cta.label}
          </Button>
          <p class="text-sm text-brand-100/75">
            ¿Prefieres llamar?{' '}
            <a href={phone.href} class="font-semibold text-white underline-offset-4 hover:underline">{phone.display}</a>
          </p>
        </div>
      </div>

      {
        image && (
          <div data-animate="clip" style="--delay: 250ms" class="relative min-h-72 lg:min-h-full">
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              class="absolute inset-0 size-full object-cover lg:rounded-l-[999px]"
            />
            <div class="absolute inset-0 bg-linear-to-t from-brand-950/50 to-transparent lg:bg-linear-to-r lg:from-brand-950/40" aria-hidden="true" />
          </div>
        )
      }
    </div>
  </div>
</section>
