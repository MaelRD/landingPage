---
import Button from './ui/Button.astro';
import Field from './ui/Field.astro';
import Icon from './ui/Icon.astro';
import SectionHeading from './ui/SectionHeading.astro';
import { OPEN_DAYS, SITE } from '@/config/site';
import { whatsappUrl } from '@/lib/whatsapp';
import type { SectionCopy } from '@/types';

interface Props extends SectionCopy {
  /** Opciones del selector de servicio. */
  services: string[];
  formTitle: string;
  submit: string;
  privacyNote: string;
}

const { services, formTitle, submit, privacyNote, ...heading } = Astro.props;
const { contact } = SITE;

const closedDayMessage = `Ese día no abrimos. Atendemos ${SITE.hours.map((h) => h.label.toLowerCase()).join(' y ')}.`;

const details = [
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: contact.phoneDisplay,
    href: whatsappUrl(),
    external: true,
  },
  { icon: 'phone', label: 'Teléfono', value: contact.phoneDisplay, href: `tel:${contact.phone}` },
  { icon: 'mail', label: 'Correo', value: contact.email, href: `mailto:${contact.email}` },
  {
    icon: 'map-pin',
    label: 'Dirección',
    value: `${contact.address.street}, ${contact.address.region}`,
    href: contact.mapsUrl,
    external: true,
  },
] as const;
---

<section id="contacto" aria-labelledby="contacto-title" class="section-y">
  <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 xl:gap-24">
    <!-- Información -->
    <div class="flex flex-col">
      <SectionHeading id="contacto-title" {...heading} />

      <ul data-stagger class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
        {
          details.map((item) => (
            <li data-animate>
              <a
                href={item.href}
                {...('external' in item && { target: '_blank', rel: 'noopener' })}
                class="group flex items-center gap-4 rounded-2xl bg-white p-4 ring-1 ring-ink/8 transition-[box-shadow] hover:shadow-soft hover:ring-brand-200"
              >
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-900 group-hover:text-white">
                  <Icon name={item.icon} size={20} />
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-medium text-muted">{item.label}</span>
                  <span class="block text-[0.95rem] font-semibold break-words text-ink">{item.value}</span>
                </span>
                {'external' in item && <span class="sr-only">(se abre en una pestaña nueva)</span>}
              </a>
            </li>
          ))
        }
      </ul>

      <div data-animate class="mt-6 rounded-2xl bg-white p-5 ring-1 ring-ink/8">
        <p class="flex items-center gap-2 text-sm font-semibold text-ink">
          <Icon name="clock" size={18} class="text-accent-600" />
          Horario de atención
        </p>
        <dl class="mt-3 space-y-1.5 text-[0.95rem]">
          {
            SITE.hours.map((h) => (
              <div class="flex justify-between gap-4">
                <dt class="text-muted">{h.label}</dt>
                <dd class="font-medium text-ink tabular-nums">
                  {h.opens} – {h.closes}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Formulario -->
    <div data-animate style="--delay: 150ms" class="rounded-4xl bg-white p-5 shadow-lift ring-1 ring-ink/6 sm:p-8 lg:p-10">
      <h3 class="font-display text-2xl font-bold tracking-[-0.03em] text-ink">{formTitle}</h3>
      <p class="mt-1.5 text-sm text-muted">Los campos marcados como opcionales puedes dejarlos en blanco.</p>

      <form
        class="mt-7 grid gap-5 sm:grid-cols-2"
        novalidate
        data-appointment-form
        data-locale={SITE.dateLocale}
        data-open-days={OPEN_DAYS.join(',')}
        data-closed-message={closedDayMessage}
      >
        <Field id="nombre" label="Nombre">
          <input
            id="nombre"
            name="name"
            type="text"
            autocomplete="name"
            required
            minlength="2"
            maxlength="60"
            placeholder="¿Cómo te llamas?"
            aria-describedby="nombre-error"
            class="form-control"
          />
        </Field>

        <Field id="whatsapp" label="WhatsApp" hint="A 10 dígitos, con lada.">
          <input
            id="whatsapp"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            maxlength="20"
            placeholder="55 1234 5678"
            aria-describedby="whatsapp-hint whatsapp-error"
            class="form-control"
          />
        </Field>

        <Field id="tratamiento" label="Tratamiento de interés">
          <div class="relative">
            <select id="tratamiento" name="service" required aria-describedby="tratamiento-error" class="form-control pr-11">
              <option value="" disabled selected>Selecciona una opción</option>
              {services.map((service) => <option value={service}>{service}</option>)}
              <option value="general">Aún no lo sé, quiero una valoración</option>
            </select>
            <Icon
              name="chevron-down"
              size={18}
              class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-muted"
            />
          </div>
        </Field>

        <Field id="fecha" label="Fecha preferida" optional>
          <input id="fecha" name="date" type="date" aria-describedby="fecha-error" class="form-control" />
        </Field>

        <Field id="mensaje" label="Mensaje" optional class="sm:col-span-2">
          <textarea
            id="mensaje"
            name="notes"
            rows="4"
            maxlength="500"
            placeholder="Cuéntanos brevemente qué necesitas o tu horario ideal."
            aria-describedby="mensaje-error"
            class="form-control resize-y"></textarea>
        </Field>

        <div class="sm:col-span-2">
          <Button type="submit" variant="whatsapp" size="lg" icon="whatsapp" class="w-full">
            {submit}
          </Button>
          <p class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-muted">
            <Icon name="lock" size={14} class="mt-0.5" />
            <span>
              {privacyNote} Consulta nuestro <a href="/aviso-de-privacidad" class="font-medium text-brand-700 underline underline-offset-2 hover:text-brand-950">aviso de privacidad</a>.
            </span>
          </p>
        </div>

        <div
          role="status"
          aria-live="polite"
          data-form-status
          class="hidden rounded-2xl bg-accent-50 p-4 text-sm text-accent-700 ring-1 ring-accent-200 sm:col-span-2"
        >
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { buildAppointmentMessage, whatsappUrl } from '@/lib/whatsapp';

  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>('[data-appointment-form]');

  if (form) {
    const locale = form.dataset.locale ?? 'es-MX';
    const openDays = (form.dataset.openDays ?? '').split(',').filter(Boolean).map(Number);
    const closedMessage = form.dataset.closedMessage ?? 'Ese día no abrimos.';
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const field = <T extends Control>(name: string) => form.elements.namedItem(name) as T;

    const name = field<HTMLInputElement>('name');
    const phone = field<HTMLInputElement>('phone');
    const service = field<HTMLSelectElement>('service');
    const date = field<HTMLInputElement>('date');
    const notes = field<HTMLTextAreaElement>('notes');

    // Fechas en hora local (evita desfases de zona horaria de `new Date('YYYY-MM-DD')`).
    const toISODate = (d: Date) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const parseISODate = (value: string) => {
      const [y, m, d] = value.split('-').map(Number);
      return new Date(y, m - 1, d);
    };
    const today = toISODate(new Date());
    date.min = today;

    const digits = (value: string) => value.replace(/\D/g, '');

    const validators = new Map<Control, () => string>([
      [name, () => (name.value.trim().length < 2 ? 'Escribe tu nombre para saber cómo llamarte.' : '')],
      [
        phone,
        () => {
          const count = digits(phone.value).length;
          if (count === 0) return 'Escribe tu número de WhatsApp.';
          return count < 10 || count > 15 ? 'Revisa tu número: debe tener al menos 10 dígitos.' : '';
        },
      ],
      [service, () => (service.value ? '' : 'Elige un tratamiento o la opción «Aún no lo sé».')],
      [
        date,
        () => {
          if (!date.value) return '';
          if (date.value < today) return 'Elige una fecha a partir de hoy.';
          if (openDays.length && !openDays.includes(parseISODate(date.value).getDay())) return closedMessage;
          return '';
        },
      ],
      [notes, () => (notes.value.length > 500 ? 'El mensaje no puede superar 500 caracteres.' : '')],
    ]);

    const showError = (control: Control, message: string) => {
      const error = control.closest('[data-field]')?.querySelector<HTMLElement>('[data-error]');
      control.setAttribute('aria-invalid', String(Boolean(message)));
      if (!error) return;
      error.textContent = message;
      error.classList.toggle('hidden', !message);
      error.classList.toggle('flex', Boolean(message));
    };

    const validate = (control: Control) => {
      const message = validators.get(control)?.() ?? '';
      showError(control, message);
      return !message;
    };

    // Valida al salir del campo y, si ya mostraba un error, mientras se corrige.
    for (const control of validators.keys()) {
      control.addEventListener('blur', () => control.value && validate(control));
      control.addEventListener('input', () => control.getAttribute('aria-invalid') === 'true' && validate(control));
      control.addEventListener('change', () => control.getAttribute('aria-invalid') === 'true' && validate(control));
    }

    const formatDate = (value: string) =>
      new Intl.DateTimeFormat(locale, { weekday: 'long', day: 'numeric', month: 'long' })
        .format(parseISODate(value))
        .replace(',', '');

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const invalid = [...validators.keys()].filter((control) => !validate(control));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      const message = buildAppointmentMessage({
        name: name.value.trim(),
        phone: phone.value.trim(),
        service: service.value === 'general' ? '' : service.value,
        date: date.value ? formatDate(date.value) : undefined,
        notes: notes.value.trim() || undefined,
      });
      const url = whatsappUrl(message);

      // Si el navegador bloquea la pestaña nueva, abrimos WhatsApp en la misma.
      const tab = window.open(url, '_blank');
      if (tab) tab.opener = null;
      else window.location.href = url;

      status.innerHTML = '';
      const text = document.createElement('p');
      text.innerHTML = '<strong>¡Listo!</strong> Abrimos WhatsApp con tu mensaje. Solo presiona enviar en el chat. ';
      const link = Object.assign(document.createElement('a'), {
        href: url,
        target: '_blank',
        rel: 'noopener',
        textContent: '¿No se abrió? Toca aquí.',
        className: 'font-semibold underline underline-offset-2',
      });
      text.append(link);
      status.append(text);
      status.classList.remove('hidden');
    });
  }
</script>
